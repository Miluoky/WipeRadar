# Без STEAM_API_KEY воркер запускается в демо-режиме (синтетические серверы).
# Ключ: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Прод: postgres://user:pass@host:5432/wiperadar (лучше с TimescaleDB). Пусто → встроенный PGlite
DATABASE_URL=
# Папка PGlite (только без DATABASE_URL). На Windows + OneDrive вынесите её из синхронизируемой папки
PGLITE_DIR=./data/pglite
PORT=4000
# Публичный адрес сайта. CORS разрешён только для него; пусто → кросс-доменный доступ закрыт (сайт ходит через свой /api)
SITE_URL=
# База стран в формате MaxMind .mmdb. Подходит бесплатная DB-IP Lite Country:
# https://db-ip.com/db/download/ip-to-country-lite (или MaxMind GeoLite2-Country). Пусто → регион по тегам и имени
GEOIP_DB=
# Интервал опроса списка Steam, сек
LIST_INTERVAL_SEC=120
# Фильтры Steam GetServerList через «;». Один ответ Steam ограничен 10 тыс. строк, поэтому список разбит на шарды
LIST_SHARDS=\appid\252490\empty\1;\appid\252490\noplayers\1
# Rust-пробер (services/prober): http://127.0.0.1:4100. Пусто → опрос RULES из Node
PROBER_URL=
# Опрос RULES из Node: параллельных запросов всего и на один IP хостинга
RULES_CONCURRENCY=64
PER_HOST_CONCURRENCY=3
# Как часто перечитывать RULES одного сервера, ч
RULES_TTL_HOURS=6
# Сколько дней хранить 5-минутные метрики онлайна
METRICS_RETENTION_DAYS=35
# Лимиты публичного API: запросов в минуту с одного IP, SSE-подключений с одного IP и всего
RATE_LIMIT_PER_MIN=300
SSE_MAX_PER_IP=5
SSE_MAX_TOTAL=5000

# --- только для docker compose (файл .env рядом с docker-compose.yml) ---
# Домен сайта: Caddy получит на него HTTPS-сертификат. SITE_URL тогда задаётся из него
SITE_DOMAIN=
POSTGRES_PASSWORD=change-me
