# Без STEAM_API_KEY воркер запускается в демо-режиме (синтетические серверы).
# Ключ: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Прод: postgres://user:pass@host:5432/wiperadar  (лучше с TimescaleDB). Пусто → встроенный PGlite в ./data
DATABASE_URL=
PORT=4000
# Путь к GeoLite2-Country.mmdb (https://dev.maxmind.com/geoip/geolite2-free-geolocation-data)
GEOIP_DB=
# Интервал опроса списка Steam, сек
LIST_INTERVAL_SEC=120
# Rust-пробер (services/prober): http://127.0.0.1:4100. Пусто → опрос из Node
PROBER_URL=
