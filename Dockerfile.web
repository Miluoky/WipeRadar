FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/a2s/package.json packages/a2s/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @wiperadar/web --include-workspace-root
COPY packages packages
COPY apps/web apps/web
# rewrites (and robots/sitemap) are baked at build time; Railway passes service variables as build args
ARG API_URL=http://worker:4000
ARG SITE_URL=http://localhost:3000
ENV API_URL=$API_URL SITE_URL=$SITE_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w @wiperadar/web

# standalone output: server.js + only the node_modules it actually imports (no dev deps, no sources)
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
